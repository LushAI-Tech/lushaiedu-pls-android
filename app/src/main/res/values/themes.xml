<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LushAIEdu_PLS" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Shown at launch; plain white until Compose splash is ready. -->
    <style name="Theme.LushAIEdu_PLS.Splash" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.LushAIEdu_PLS</item>
    </style>

</resources>
